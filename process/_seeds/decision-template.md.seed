## 3. Candidate Options (I1: Repo-Native Candidates)

<!-- PRINCIPLE: REPO-NATIVE FIRST — Maximize existing abstractions and conventions established in repo -->
<options>

  <option id="A" type="Minimalist">
    <title>In-Place Minimalist / Defect-Focused Intervention</title>
    <approach>[Minimal solution, fixing defect directly at failure origin]</approach>
    <repo_native_alignment>[Reuses existing helper functions and utilities in repository]</repo_native_alignment>
    <complexity>LOW</complexity>
    <blast_radius>MINIMAL</blast_radius>
  </option>

  <option id="B" type="Repo-Idiomatic">
    <title>Repo-Idiomatic Architectural Alignment</title>
    <approach>[Standard pattern aligned with repo conventions (Service/Repo/Layering)]</approach>
    <repo_native_alignment>[Employs existing abstractions and event dispatchers from neighboring modules]</repo_native_alignment>
    <complexity>MEDIUM</complexity>
    <blast_radius>MODERATE</blast_radius>
  </option>

  <option id="C" type="Extensible">
    <title>Extensible / Modular Isolation (Strategy / Adapter Pattern)</title>
    <approach>[Future-proof architecture decoupled via interfaces]</approach>
    <repo_native_alignment>[Conforms to existing Factory/Provider design contracts in codebase]</repo_native_alignment>
    <complexity>HIGH</complexity>
    <blast_radius>CONTROLLED</blast_radius>
